# Copy the variables you need into Railway -> service -> Variables (or a local .env).

# Required in production: password for the first officer account (min 10 characters).
CV_ADMIN_PASSWORD=change-me-to-a-long-secret
# Optional: officer sign-in email (default admin@citizenvoice.ng)
CV_ADMIN_EMAIL=admin@citizenvoice.ng

# Optional: "production" is chosen automatically on Railway; set it explicitly elsewhere.
# CV_ENV=production
# Optional: database file. On Railway, attaching a volume is enough (RAILWAY_VOLUME_MOUNT_PATH).
# CV_DB_PATH=/data/citizenvoice.db
# Optional
# CV_TOKEN_TTL_HOURS=168
# CV_USE_TRANSFORMER=1
# CV_LOG_LEVEL=INFO
